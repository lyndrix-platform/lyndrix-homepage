---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Plugin Development — Lyndrix" description="Build powerful plugins for Lyndrix. Learn the plugin contract, ctx API, event bus, health checks, and deploy your first plugin in minutes.">
	<Navbar />

	<!-- ─── HERO ────────────────────────────────────────────────────── -->
	<section class="plugin-hero">
		<div class="hero-bg">
			<div class="hero-grid"></div>
			<div class="hero-glow hero-glow-1"></div>
			<div class="hero-glow hero-glow-2"></div>
		</div>

		<div class="hero-container">
			<div class="hero-content">
				<div class="hero-badge">
					<span class="badge-dot"></span>
					Plugin SDK · Python · Open Source
				</div>

				<h1 class="hero-title">
					Write once.<br />
					<span class="hero-title-accent">Deploy everywhere.</span>
				</h1>

				<p class="hero-subtitle">
					Lyndrix plugins are self-contained Python packages. One <code>setup(ctx)</code> function and you get auth, secrets, a database, an event bus, and a live UI — all wired in by the platform.
				</p>

				<div class="hero-actions">
					<a href="https://docs.lyndrix.eu/plugins/" class="btn-primary" target="_blank" rel="noopener noreferrer">
						Read the Docs →
					</a>
					<a href="https://github.com/lyndrix-platform/lyndrix-plugin-collection" class="btn-secondary" target="_blank" rel="noopener noreferrer">
						Browse Plugins
					</a>
				</div>
			</div>

			<div class="hero-code">
				<div class="code-panel">
					<div class="code-header">
						<div class="code-dots">
							<span class="dot dot-red"></span>
							<span class="dot dot-yellow"></span>
							<span class="dot dot-green"></span>
						</div>
						<span class="code-filename">entrypoint.py</span>
						<span class="code-lang">Python</span>
					</div>
					<pre class="code-block"><code><span class="kw">from</span> <span class="mod">core.api</span> <span class="kw">import</span> ModuleManifest
<span class="kw">from</span> <span class="mod">nicegui</span> <span class="kw">import</span> ui

manifest = ModuleManifest(
    id=<span class="str">"lyndrix.plugin.myapp"</span>,
    name=<span class="str">"My App"</span>,
    version=<span class="str">"1.0.0"</span>,
    type=<span class="str">"PLUGIN"</span>,
    ui_route=<span class="str">"/myapp"</span>,
    permissions=&#123;
        <span class="str">"subscribe"</span>: [<span class="str">"system:boot_complete"</span>],
        <span class="str">"emit"</span>: [<span class="str">"myapp:event"</span>],
    &#125;,
)

<span class="kw">async def</span> <span class="fn">setup</span>(ctx):
    <span class="comment"># Vault-backed config, auto-decrypted</span>
    token = <span class="kw">await</span> ctx.get_secret(<span class="str">"my_api_token"</span>)

    <span class="comment"># Subscribe to platform events</span>
    <span class="kw">await</span> ctx.subscribe(<span class="str">"system:boot_complete"</span>, on_boot)

    <span class="comment"># Register a UI route + settings panel</span>
    ctx.register_routes(router)
    ctx.register_settings_panel(render_settings)

<span class="kw">async def</span> <span class="fn">health_check</span>():
    <span class="comment"># Required: platform polls this on /api/health</span>
    <span class="kw">return</span> &#123;<span class="str">"status"</span>: <span class="str">"ok"</span>, <span class="str">"version"</span>: manifest.version&#125;</code></pre>
				</div>
			</div>
		</div>
	</section>

	<!-- ─── WHAT YOU GET ────────────────────────────────────────────── -->
	<section class="section ctx-section" id="ctx-api">
		<div class="section-container">
			<div class="section-header">
				<span class="section-tag">The Context API</span>
				<h2 class="section-title">Everything wired.<br />Zero boilerplate.</h2>
				<p class="section-subtitle">
					The <code>ctx</code> object passed to <code>setup()</code> is your gateway to every Lyndrix subsystem. No imports, no singletons — just call it.
				</p>
			</div>

			<div class="ctx-grid">
				<div class="ctx-card">
					<div class="ctx-icon">
						<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 00-1-1.73l-7-4a2 2 0 00-2 0l-7 4A2 2 0 003 8v8a2 2 0 001 1.73l7 4a2 2 0 002 0l7-4A2 2 0 0021 16z"/></svg>
					</div>
					<div class="ctx-body">
						<h3>Secrets & Config</h3>
						<p>Read and write Vault-backed secrets scoped to your plugin. No token management.</p>
						<code>ctx.get_secret("key")</code>
					</div>
				</div>
				<div class="ctx-card">
					<div class="ctx-icon">
						<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
					</div>
					<div class="ctx-body">
						<h3>Event Bus</h3>
						<p>Subscribe and emit typed events across the entire platform. Decoupled by default.</p>
						<code>ctx.subscribe("topic", handler)</code>
					</div>
				</div>
				<div class="ctx-card">
					<div class="ctx-icon">
						<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"/><path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"/></svg>
					</div>
					<div class="ctx-body">
						<h3>Database</h3>
						<p>SQLAlchemy-backed sessions shared with the platform. Your models, no setup.</p>
						<code>ctx.get_db_session()</code>
					</div>
				</div>
				<div class="ctx-card">
					<div class="ctx-icon">
						<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
					</div>
					<div class="ctx-body">
						<h3>UI & Routes</h3>
						<p>Register FastAPI routers and NiceGUI pages. Your plugin owns its URL namespace.</p>
						<code>ctx.register_routes(router)</code>
					</div>
				</div>
				<div class="ctx-card">
					<div class="ctx-icon">
						<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.07 4.93a10 10 0 010 14.14M4.93 4.93a10 10 0 000 14.14"/></svg>
					</div>
					<div class="ctx-body">
						<h3>Notifications</h3>
						<p>Send real-time in-app toasts and persistent bell notifications with a single call.</p>
						<code>ctx.notify("msg", type="info")</code>
					</div>
				</div>
				<div class="ctx-card">
					<div class="ctx-icon">
						<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
					</div>
					<div class="ctx-body">
						<h3>Permissions</h3>
						<p>Declare which events you emit or subscribe to. The platform enforces boundaries at runtime.</p>
						<code>manifest.permissions</code>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- ─── PLUGIN ANATOMY ──────────────────────────────────────────── -->
	<section class="section anatomy-section" id="anatomy">
		<div class="section-container">
			<div class="section-header">
				<span class="section-tag">Plugin Structure</span>
				<h2 class="section-title">Anatomy of a plugin</h2>
				<p class="section-subtitle">
					A Lyndrix plugin is just a directory. Lyndrix discovers it, validates the manifest, installs dependencies, and calls <code>setup(ctx)</code>.
				</p>
			</div>

			<div class="anatomy-layout">
				<div class="file-tree-panel">
					<div class="code-panel">
						<div class="code-header">
							<div class="code-dots">
								<span class="dot dot-red"></span>
								<span class="dot dot-yellow"></span>
								<span class="dot dot-green"></span>
							</div>
							<span class="code-filename">lyndrix-plugin-myapp/</span>
						</div>
						<pre class="code-block file-tree"><code><span class="tree-dir">lyndrix-plugin-myapp/</span>
<span class="tree-line">├── </span><span class="tree-required">entrypoint.py</span>      <span class="tree-comment"># manifest + setup(ctx)</span>
<span class="tree-line">├── </span><span class="tree-file">requirements.txt</span>   <span class="tree-comment"># plugin dependencies</span>
<span class="tree-line">├── </span><span class="tree-dir">app/</span>
<span class="tree-line">│   ├── </span><span class="tree-file">controller/</span>    <span class="tree-comment"># FastAPI routers</span>
<span class="tree-line">│   ├── </span><span class="tree-file">model/</span>         <span class="tree-comment"># SQLAlchemy models</span>
<span class="tree-line">│   ├── </span><span class="tree-file">ui/</span>            <span class="tree-comment"># NiceGUI pages</span>
<span class="tree-line">│   └── </span><span class="tree-file">logic/</span>         <span class="tree-comment"># Business logic</span>
<span class="tree-line">└── </span><span class="tree-file">vendor/</span>            <span class="tree-comment"># Auto-installed deps</span></code></pre>
					</div>

					<div class="anatomy-callout">
						<div class="callout-icon">
							<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
						</div>
						<p>Lyndrix auto-installs <code>requirements.txt</code> into <code>vendor/</code> at load time — fully isolated from the core and other plugins.</p>
					</div>
				</div>

				<div class="anatomy-steps">
					<div class="anatomy-step">
						<div class="step-num">01</div>
						<div class="step-content">
							<h3>Declare the manifest</h3>
							<p>The <code>ModuleManifest</code> describes your plugin's identity, version, UI route, and event permissions. It's the source of truth the platform reads on load.</p>
						</div>
					</div>
					<div class="anatomy-step">
						<div class="step-num">02</div>
						<div class="step-content">
							<h3>Implement <code>setup(ctx)</code></h3>
							<p>This async function runs once after the platform is ready. Wire up your routes, subscribe to events, load secrets, and register any UI panels here.</p>
						</div>
					</div>
					<div class="anatomy-step">
						<div class="step-num">03</div>
						<div class="step-content">
							<h3>Implement <code>health_check()</code></h3>
							<p>This async function is called by the platform's global <code>/api/health</code> endpoint. Return a dict with at minimum a <code>status</code> field so Lyndrix can surface your plugin's live state.</p>
						</div>
					</div>
					<div class="anatomy-step">
						<div class="step-num">04</div>
						<div class="step-content">
							<h3>Push and install</h3>
							<p>Tag a release on GitHub. In the Lyndrix Plugin Manager, paste the repo URL. The platform clones, validates, installs dependencies, and activates — no restarts needed.</p>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- ─── HEALTH CHECK ────────────────────────────────────────────── -->
	<section class="section health-section" id="health">
		<div class="section-container">
			<div class="health-layout">
				<div class="health-content">
					<span class="section-tag">Platform Contract</span>
					<h2 class="health-title">Built-in health checks</h2>
					<p class="health-desc">
						Every plugin must expose an async <code>health_check()</code> function. Lyndrix aggregates all plugin health responses into a single <code>/api/health</code> endpoint — giving you one unified status view for your entire application.
					</p>

					<ul class="health-list">
						<li>
							<span class="health-check-icon">
								<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
							</span>
							Aggregated automatically — no registration required
						</li>
						<li>
							<span class="health-check-icon">
								<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
							</span>
							Return any additional fields — service URLs, queue depths, last sync
						</li>
						<li>
							<span class="health-check-icon">
								<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
							</span>
							Caught exceptions map to <code>"status": "error"</code> automatically
						</li>
						<li>
							<span class="health-check-icon">
								<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
							</span>
							Surfaced in the Lyndrix dashboard and the API response
						</li>
					</ul>
				</div>

				<div class="health-code">
					<div class="code-panel">
						<div class="code-header">
							<div class="code-dots">
								<span class="dot dot-red"></span>
								<span class="dot dot-yellow"></span>
								<span class="dot dot-green"></span>
							</div>
							<span class="code-filename">GET /api/health</span>
							<span class="code-lang">JSON</span>
						</div>
						<pre class="code-block"><code>&#123;
  <span class="str">"status"</span>: <span class="str">"ok"</span>,
  <span class="str">"core_version"</span>: <span class="str">"0.3.0"</span>,
  <span class="str">"vault"</span>: <span class="str">"ready"</span>,
  <span class="str">"plugins"</span>: &#123;
    <span class="str">"lyndrix.plugin.myapp"</span>: &#123;
      <span class="str">"status"</span>: <span class="str">"ok"</span>,
      <span class="str">"version"</span>: <span class="str">"1.0.0"</span>,
      <span class="str">"last_sync"</span>: <span class="str">"2026-06-03T12:00:00Z"</span>
    &#125;,
    <span class="str">"lyndrix.plugin.iac"</span>: &#123;
      <span class="str">"status"</span>: <span class="str">"ok"</span>,
      <span class="str">"version"</span>: <span class="str">"0.3.0"</span>,
      <span class="str">"runners"</span>: 3,
      <span class="str">"jobs_running"</span>: 1
    &#125;
  &#125;
&#125;</code></pre>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- ─── LIFECYCLE ───────────────────────────────────────────────── -->
	<section class="section lifecycle-section" id="lifecycle">
		<div class="section-container">
			<div class="section-header">
				<span class="section-tag">Lifecycle</span>
				<h2 class="section-title">How a plugin boots</h2>
				<p class="section-subtitle">
					Lyndrix follows a strict boot order. Your plugin is loaded only after Vault, the database, and IAM are all online.
				</p>
			</div>

			<div class="timeline">
				<div class="timeline-item">
					<div class="timeline-node node-core">
						<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0110 0v4"/></svg>
					</div>
					<div class="timeline-content">
						<h4>Vault unsealed</h4>
						<p>HashiCorp Vault is initialized and opened. Secrets are available.</p>
					</div>
				</div>
				<div class="timeline-connector"></div>
				<div class="timeline-item">
					<div class="timeline-node node-core">
						<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"/><path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"/></svg>
					</div>
					<div class="timeline-content">
						<h4>Database ready</h4>
						<p>Migrations applied. Shared DB session pool is open.</p>
					</div>
				</div>
				<div class="timeline-connector"></div>
				<div class="timeline-item">
					<div class="timeline-node node-core">
						<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
					</div>
					<div class="timeline-content">
						<h4>IAM online</h4>
						<p>Auth providers loaded. Emits <code>iam:ready</code> → triggers plugin loader.</p>
					</div>
				</div>
				<div class="timeline-connector timeline-connector-plugin"></div>
				<div class="timeline-item">
					<div class="timeline-node node-plugin">
						<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 00-1-1.73l-7-4a2 2 0 00-2 0l-7 4A2 2 0 003 8v8a2 2 0 001 1.73l7 4a2 2 0 002 0l7-4A2 2 0 0021 16z"/></svg>
					</div>
					<div class="timeline-content">
						<h4>Plugins loaded</h4>
						<p>Manifest validated, <code>vendor/</code> installed, <code>setup(ctx)</code> called for each plugin.</p>
					</div>
				</div>
				<div class="timeline-connector"></div>
				<div class="timeline-item">
					<div class="timeline-node node-plugin">
						<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
					</div>
					<div class="timeline-content">
						<h4><code>system:boot_complete</code></h4>
						<p>All plugins are live. Background tasks, timers, and event handlers are active.</p>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- ─── EVENT BUS DEEP DIVE ─────────────────────────────────────── -->
	<section class="section events-section" id="events">
		<div class="section-container">
			<div class="section-header">
				<span class="section-tag">Event-Driven</span>
				<h2 class="section-title">Talk through the bus.</h2>
				<p class="section-subtitle">
					Plugins never import each other. All inter-plugin communication happens through typed events on the global bus — declared in the manifest, enforced at runtime.
				</p>
			</div>

			<div class="events-grid">
				<div class="events-code">
					<div class="code-panel">
						<div class="code-header">
							<div class="code-dots">
								<span class="dot dot-red"></span>
								<span class="dot dot-yellow"></span>
								<span class="dot dot-green"></span>
							</div>
							<span class="code-filename">plugin_a — emits events</span>
							<span class="code-lang">Python</span>
						</div>
						<pre class="code-block"><code><span class="comment"># Plugin A: triggers a deployment</span>
<span class="kw">async def</span> <span class="fn">deploy</span>(service: str):
    ctx.emit(
        <span class="str">"iac:deploy_requested"</span>,
        &#123;<span class="str">"service"</span>: service, <span class="str">"env"</span>: <span class="str">"prod"</span>&#125;
    )</code></pre>
					</div>
					<div class="code-panel">
						<div class="code-header">
							<div class="code-dots">
								<span class="dot dot-red"></span>
								<span class="dot dot-yellow"></span>
								<span class="dot dot-green"></span>
							</div>
							<span class="code-filename">plugin_b — reacts to events</span>
							<span class="code-lang">Python</span>
						</div>
						<pre class="code-block"><code><span class="comment"># Plugin B: handles the deployment</span>
<span class="kw">async def</span> <span class="fn">setup</span>(ctx):
    <span class="kw">await</span> ctx.subscribe(
        <span class="str">"iac:deploy_requested"</span>,
        handle_deploy
    )

<span class="kw">async def</span> <span class="fn">handle_deploy</span>(payload):
    service = payload[<span class="str">"service"</span>]
    <span class="comment"># ... run pipeline</span></code></pre>
					</div>
				</div>

				<div class="events-topics">
					<h3 class="topics-title">Platform-native topics</h3>
					<p class="topics-desc">These events are emitted by Lyndrix Core — subscribe to them without needing special permissions.</p>
					<div class="topic-list">
						<div class="topic-item"><code>system:boot_complete</code><span>Platform fully booted</span></div>
						<div class="topic-item"><code>system:boot_phase</code><span>Boot phase changed</span></div>
						<div class="topic-item"><code>vault:opened</code><span>Vault unsealed and ready</span></div>
						<div class="topic-item"><code>vault:ready_for_data</code><span>Safe to read secrets</span></div>
						<div class="topic-item"><code>iam:ready</code><span>Auth providers loaded</span></div>
						<div class="topic-item"><code>system:maintenance_mode</code><span>Maintenance toggled</span></div>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- ─── GET STARTED ─────────────────────────────────────────────── -->
	<section class="section start-section" id="get-started">
		<div class="section-container">
			<div class="start-card">
				<div class="start-glow"></div>
				<div class="start-content">
					<h2 class="start-title">Ready to build?</h2>
					<p class="start-subtitle">
						Clone the plugin template, implement your <code>setup(ctx)</code>, push a tag — and your plugin is live on Lyndrix in minutes.
					</p>
					<div class="start-actions">
						<a href="https://docs.lyndrix.eu/plugins/" class="btn-primary" target="_blank" rel="noopener noreferrer">
							Plugin Docs →
						</a>
						<a href="https://github.com/lyndrix-platform" class="btn-secondary" target="_blank" rel="noopener noreferrer">
							GitHub Organization
						</a>
					</div>
				</div>
