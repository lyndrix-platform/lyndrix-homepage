---
const plugins = [
	{
		name: 'IaC Orchestrator',
		repo: 'lyndrix-plugin-iac-orchestrator',
		description: 'GitOps controller for Terraform and Ansible pipelines — webhook triggers, drift detection, and parallel provisioning.',
		url: 'https://github.com/lyndrix-platform/lyndrix-plugin-iac-orchestrator',
		docs: 'https://iac-orchestrator.docs.lyndrix.eu',
	},
	{
		name: 'Server Manager',
		repo: 'lyndrix-plugin-server-manager',
		description: 'Central server inventory built on configurable hardware catalogs, combination rules, and event-bus hooks.',
		url: 'https://github.com/lyndrix-platform/lyndrix-plugin-server-manager',
		docs: 'https://server-manager.docs.lyndrix.eu',
	},
	{
		name: 'Docker Manager',
		repo: 'lyndrix-plugin-docker-manager',
		description: 'Docker monitoring with runtime controls — start/stop/restart/logs/shell — through the core sockets layer.',
		url: 'https://github.com/lyndrix-platform/lyndrix-plugin-docker-manager',
		docs: 'https://docker-manager.docs.lyndrix.eu',
	},
	{
		name: 'State Monitoring',
		repo: 'lyndrix-plugin-monitoring',
		description: 'Native infrastructure and service monitoring with persistent, grouped status timelines and inventory sync.',
		url: 'https://github.com/lyndrix-platform/lyndrix-plugin-monitoring',
		docs: 'https://monitoring.docs.lyndrix.eu',
	},
	{
		name: 'External Services',
		repo: 'lyndrix-plugin-external-services',
		description: 'Embed external web UIs (Home Assistant, Grafana, …) as full-screen iframes via a managed service registry.',
		url: 'https://github.com/lyndrix-platform/lyndrix-plugin-external-services',
		docs: 'https://external-services.docs.lyndrix.eu',
	},
	{
		name: 'Discord Notifier',
		repo: 'lyndrix-plugin-discord-notifier',
		description: 'Two-way Discord integration (bot API + webhook) as a Messaging Gateway adapter, with multiple channel instances.',
		url: 'https://github.com/lyndrix-platform/lyndrix-plugin-discord-notifier',
		docs: 'https://discord-notifier.docs.lyndrix.eu',
	},
	{
		name: 'Meeting Bingo',
		repo: 'lyndrix-plugin-meeting-bingo',
		description: 'Multiplayer bullshit-bingo for long meetings — a reference plugin proving Lyndrix fits any use case.',
		url: 'https://github.com/lyndrix-platform/lyndrix-plugin-meeting-bingo',
		docs: 'https://meeting-bingo.docs.lyndrix.eu',
	},
];
---

<section class="ecosystem" id="ecosystem">
	<div class="eco-container">
		<div class="section-header">
			<span class="section-tag">Ecosystem</span>
			<h2 class="section-title">Plugin Ecosystem</h2>
			<p class="section-subtitle">
				Lyndrix ships with a growing library of official plugins, each with its own docs site. Any developer can publish their own.
			</p>
		</div>

		<div class="plugins-grid">
			{plugins.map((plugin) => (
				<div class="plugin-card">
					<div class="plugin-header">
						<div class="plugin-icon">
							<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
								<path d="M21 16V8a2 2 0 00-1-1.73l-7-4a2 2 0 00-2 0l-7 4A2 2 0 003 8v8a2 2 0 001 1.73l7 4a2 2 0 002 0l7-4A2 2 0 0021 16z"/>
								<polyline points="3.27 6.96 12 12.01 20.73 6.96"/>
								<line x1="12" y1="22.08" x2="12" y2="12"/>
							</svg>
						</div>
						<span class="plugin-badge">
							<svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><path d="M14.25 2.26a.75.75 0 00-.75-.76H4a2 2 0 00-2 2v14a2 2 0 002 2h16a2 2 0 002-2v-7.5a.75.75 0 00-.75-.75h-7.5a1.5 1.5 0 01-1.5-1.5V2.26z"/><path d="M15.75 2.085V8.5h6.414a2 2 0 00-.462-.952L16.7 2.547a2 2 0 00-.952-.462z"/></svg>
							Python
						</span>
					</div>
					<div class="plugin-name">{plugin.name}</div>
					<div class="plugin-repo">{plugin.repo}</div>
					<p class="plugin-description">{plugin.description}</p>
					<div class="plugin-links">
						<a href={plugin.docs} class="plugin-link" target="_blank" rel="noopener noreferrer">
							Docs
							<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
								<path d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6"/>
								<polyline points="15 3 21 3 21 9"/>
								<line x1="10" y1="14" x2="21" y2="3"/>
							</svg>
						</a>
						<a href={plugin.url} class="plugin-link plugin-link-muted" target="_blank" rel="noopener noreferrer">
							GitHub
							<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
								<path d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6"/>
								<polyline points="15 3 21 3 21 9"/>
								<line x1="10" y1="14" x2="21" y2="3"/>
							</svg>
						</a>
					</div>
				</div>
			))}
		</div>

		<div class="eco-banner">
			<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
				<circle cx="12" cy="12" r="10"/>
				<line x1="12" y1="8" x2="12" y2="12"/>
				<line x1="12" y1="16" x2="12.01" y2="16"/>
			</svg>
			<a href="https://github.com/lyndrix-platform/lyndrix-plugin-collection" target="_blank" rel="noopener noreferrer">
				Browse all plugins
			</a>
			&nbsp;·&nbsp;Want to build your own? →&nbsp;
			<a href="https://docs.lyndrix.eu/plugins/" target="_blank" rel="noopener noreferrer">
				Read the Plugin Development Guide
			</a>
		</div>
	</div>
</section>

<style>
	.ecosystem {
		padding: var(--section-padding);
		background: var(--bg-secondary);
		position: relative;
	}

	.ecosystem::before {
		content: '';
		position: absolute;
		inset: 0;
		background-image:
			linear-gradient(rgba(0, 212, 255, 0.025) 1px, transparent 1px),
			linear-gradient(90deg, rgba(0, 212, 255, 0.025) 1px, transparent 1px);
		background-size: 50px 50px;
	}

	.eco-container {
		position: relative;
		max-width: var(--container-max);
		margin: 0 auto;
		display: flex;
		flex-direction: column;
		gap: 3rem;
	}

	.section-header {
		text-align: center;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1rem;
	}

	.section-tag {
		display: inline-block;
		padding: 0.3rem 0.875rem;
		background: rgba(0, 212, 255, 0.1);
		border: 1px solid rgba(0, 212, 255, 0.2);
		border-radius: 999px;
		font-size: 0.8rem;
		font-weight: 600;
		color: var(--accent-cyan);
		text-transform: uppercase;
		letter-spacing: 0.08em;
	}

	.section-title {
		font-size: clamp(2rem, 4vw, 3rem);
		font-weight: 800;
		line-height: 1.15;
		letter-spacing: -0.025em;
		color: var(--text-primary);
	}

	.section-subtitle {
		font-size: 1.1rem;
		color: var(--text-secondary);
		max-width: 560px;
		line-height: 1.7;
	}

	.plugins-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1.25rem;
	}

	.plugin-card {
		background: var(--bg-card);
		border: 1px solid var(--border-card);
		border-radius: var(--radius-lg);
		padding: 1.5rem;
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		text-decoration: none;
		transition: border-color var(--transition), box-shadow var(--transition), transform var(--transition);
		backdrop-filter: blur(8px);
	}

	.plugin-card:hover {
		border-color: rgba(0, 212, 255, 0.35);
		box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3), 0 0 0 1px rgba(0, 212, 255, 0.1);
		transform: translateY(-3px);
	}

	.plugin-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
	}

	.plugin-icon {
		width: 36px;
		height: 36px;
		display: flex;
		align-items: center;
		justify-content: center;
		background: rgba(0, 212, 255, 0.1);
		border-radius: var(--radius-sm);
		color: var(--accent-cyan);
	}

	.plugin-badge {
		display: flex;
		align-items: center;
		gap: 0.3rem;
		padding: 0.2rem 0.6rem;
		background: rgba(59, 130, 246, 0.12);
		border: 1px solid rgba(59, 130, 246, 0.2);
		border-radius: 999px;
		font-size: 0.72rem;
		font-weight: 600;
		color: #60a5fa;
	}

	.plugin-name {
		font-size: 1rem;
		font-weight: 700;
		color: var(--text-primary);
		letter-spacing: -0.01em;
	}

	.plugin-repo {
		font-size: 0.74rem;
		color: var(--text-secondary);
		font-family: var(--font-mono);
		word-break: break-all;
		opacity: 0.7;
		margin-top: -0.4rem;
	}

	.plugin-description {
		font-size: 0.85rem;
		color: var(--text-secondary);
		line-height: 1.6;
		flex: 1;
	}

	.plugin-links {
		display: flex;
		align-items: center;
		gap: 1.25rem;
		margin-top: auto;
	}

	.plugin-link {
		display: flex;
		align-items: center;
		gap: 0.375rem;
		font-size: 0.82rem;
		font-weight: 600;
		color: var(--accent-cyan);
		text-decoration: none;
	}

	.plugin-link:hover {
		color: var(--text-primary);
	}

	.plugin-link-muted {
		color: var(--text-secondary);
	}

	.eco-banner {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.5rem;
		padding: 1.25rem 2rem;
		background: rgba(0, 212, 255, 0.06);
		border: 1px solid rgba(0, 212, 255, 0.15);
		border-radius: var(--radius-lg);
		font-size: 0.95rem;
		color: var(--text-secondary);
	}

	.eco-banner svg {
		color: var(--accent-cyan);
		flex-shrink: 0;
	}

	.eco-banner a {
		color: var(--accent-cyan);
		font-weight: 600;
		text-decoration: underline;
		text-underline-offset: 2px;
	}

	.eco-banner a:hover {
		color: var(--text-primary);
	}

	@media (max-width: 1024px) {
		.plugins-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (max-width: 640px) {
		.plugins-grid {
			grid-template-columns: 1fr;
		}

		.eco-banner {
			flex-direction: column;
			text-align: center;
		}
	}
</style>
