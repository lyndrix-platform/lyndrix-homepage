---
const features = [
	{
		icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M11 3.055A9.001 9.001 0 1020.945 13H11V3.055z"/><path d="M20.488 9H15V3.512A9.025 9.025 0 0120.488 9z"/></svg>`,
		title: 'Plugin-First Architecture',
		description: 'Develop only what makes your app unique. Drop in a plugin with <code>setup(ctx)</code> and the framework handles the rest — auth, database, UI, and more.',
	},
	{
		icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0110 0v4"/></svg>`,
		title: 'Vault-Backed Secrets',
		description: 'First-class HashiCorp Vault integration with automatic bootstrap, unseal, and per-plugin secret isolation. Zero-trust by default.',
	},
	{
		icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>`,
		title: 'Event-Driven Core',
		description: 'A global event bus decouples every component. Plugins communicate through declared topics — no spaghetti imports, no tight coupling.',
	},
	{
		icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>`,
		title: 'Built-in Auth',
		description: 'Local, LDAP, and OIDC authentication out of the box. Plugins can register custom providers at runtime. Fine-grained permissions per plugin.',
	},
	{
		icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>`,
		title: 'Dual-Engine UI',
		description: 'Ship a React frontend (module federation, i18next, shared component library) or a NiceGUI page — or both. Set <code>react_ui=True</code> in your manifest and the core serves your Vite bundle alongside the REST API.',
	},
	{
		icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 00-1-1.73l-7-4a2 2 0 00-2 0l-7 4A2 2 0 003 8v8a2 2 0 001 1.73l7 4a2 2 0 002 0l7-4A2 2 0 0021 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></svg>`,
		title: 'Managed Dependencies',
		description: 'Each plugin gets its own <code>vendor/</code> directory. No conflicts, no pollution, no dependency hell. Plugins are isolated by design.',
	},
	{
		icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 01-.9 3.8 8.5 8.5 0 01-7.6 4.7 8.38 8.38 0 01-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 01-.9-3.8 8.5 8.5 0 014.7-7.6 8.38 8.38 0 013.8-.9h.5a8.48 8.48 0 018 8v.5z"/></svg>`,
		title: 'Messaging Gateway',
		description: 'Two-way messaging through pluggable provider adapters — Discord, Slack, and more. Emit <code>messaging:outbound</code> once; interactive replies route back to your plugin.',
	},
	{
		icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="13.5" cy="6.5" r="2.5"/><circle cx="17.5" cy="10.5" r="2.5"/><circle cx="8.5" cy="7.5" r="2.5"/><circle cx="6.5" cy="12.5" r="2.5"/><path d="M12 2a10 10 0 100 20 2.5 2.5 0 002-4 2.5 2.5 0 012-4h2a4 4 0 004-4 10 10 0 00-10-8z"/></svg>`,
		title: 'Theming Engine',
		description: 'Token + component themes drive the whole UI. Ship a custom theme as two JSON files, or scope <code>register_theme_overrides</code> to just your plugin.',
	},
	{
		icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M21 2l-2 2m-7.61 7.61a5.5 5.5 0 11-7.778 7.778 5.5 5.5 0 017.777-7.777zm0 0L15.5 7.5m0 0l3 3L22 7l-3-3m-3.5 3.5L19 4"/></svg>`,
		title: 'API Keys & Permissions',
		description: 'Guard plugin endpoints with <code>require_permission()</code>. A system key for machine-to-machine access, per-user API keys with scopes, and a Swagger Authorize button.',
	},
	{
		icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2a15.3 15.3 0 010 20M12 2a15.3 15.3 0 000 20"/></svg>`,
		title: 'Internationalisation',
		description: 'An HTTP i18n catalog serves i18next-shaped bundles to React frontends (<code>GET /api/i18n/{locale}</code>). Plugins register their own namespace; the version fingerprint keeps clients cache-coherent across deployments.',
	},
];
---

<section class="features" id="features">
	<div class="features-container">
		<div class="section-header">
			<span class="section-tag">Why Lyndrix</span>
			<h2 class="section-title">Everything you need.<br />Nothing you don't.</h2>
			<p class="section-subtitle">
				Lyndrix is the foundation your application sits on. You bring the business logic; Lyndrix brings the platform.
			</p>
		</div>

		<div class="features-grid">
			{features.map((feature) => (
				<div class="feature-card">
					<div class="feature-icon" set:html={feature.icon}></div>
					<h3 class="feature-title">{feature.title}</h3>
					<p class="feature-description" set:html={feature.description}></p>
				</div>
			))}
		</div>
	</div>
</section>

<style>
	.features {
		padding: var(--section-padding);
		background: linear-gradient(180deg, var(--bg-primary) 0%, var(--bg-secondary) 50%, var(--bg-primary) 100%);
		position: relative;
	}

	.features::before {
		content: '';
		position: absolute;
		inset: 0;
		background-image:
			linear-gradient(rgba(0, 212, 255, 0.02) 1px, transparent 1px),
			linear-gradient(90deg, rgba(0, 212, 255, 0.02) 1px, transparent 1px);
		background-size: 60px 60px;
	}

	.features-container {
		position: relative;
		max-width: var(--container-max);
		margin: 0 auto;
		display: flex;
		flex-direction: column;
		gap: 4rem;
	}

	.section-header {
		text-align: center;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1rem;
	}

	.section-tag {
		display: inline-block;
		padding: 0.3rem 0.875rem;
		background: rgba(0, 212, 255, 0.1);
		border: 1px solid rgba(0, 212, 255, 0.2);
		border-radius: 999px;
		font-size: 0.8rem;
		font-weight: 600;
		color: var(--accent-cyan);
		text-transform: uppercase;
		letter-spacing: 0.08em;
	}

	.section-title {
		font-size: clamp(2rem, 4vw, 3rem);
		font-weight: 800;
		line-height: 1.15;
		letter-spacing: -0.025em;
		color: var(--text-primary);
	}

	.section-subtitle {
		font-size: 1.1rem;
		color: var(--text-secondary);
		max-width: 560px;
		line-height: 1.7;
	}

	.features-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1.5rem;
	}

	.feature-card {
		background: var(--bg-card);
		border: 1px solid var(--border-card);
		border-radius: var(--radius-lg);
		padding: 2rem;
		display: flex;
		flex-direction: column;
		gap: 1rem;
		transition: border-color var(--transition), box-shadow var(--transition), transform var(--transition);
		backdrop-filter: blur(8px);
	}

	.feature-card:hover {
		border-color: rgba(0, 212, 255, 0.3);
		box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3), 0 0 0 1px rgba(0, 212, 255, 0.1);
		transform: translateY(-4px);
	}

	.feature-icon {
		width: 48px;
		height: 48px;
		display: flex;
		align-items: center;
		justify-content: center;
		background: rgba(0, 212, 255, 0.1);
		border-radius: var(--radius-md);
		color: var(--accent-cyan);
		flex-shrink: 0;
	}

	.feature-title {
		font-size: 1.1rem;
		font-weight: 700;
		color: var(--text-primary);
		letter-spacing: -0.01em;
	}

	.feature-description {
		font-size: 0.92rem;
		color: var(--text-secondary);
		line-height: 1.7;
	}

	.feature-description :global(code) {
		font-family: var(--font-mono);
		font-size: 0.85em;
		background: rgba(0, 212, 255, 0.1);
		color: var(--accent-cyan);
		padding: 0.1em 0.4em;
		border-radius: 4px;
	}

	@media (max-width: 1024px) {
		.features-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (max-width: 640px) {
		.features-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
