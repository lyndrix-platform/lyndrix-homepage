---
import dashboard from '../assets/lyndrix_screenshots/dark_dashbaord.png';
import login from '../assets/lyndrix_screenshots/dark_login_screen.png';
import pluginManager from '../assets/lyndrix_screenshots/dark_plugin_manager.png';
import iacOrchestrator from '../assets/lyndrix_screenshots/dark_plugin_iac_orchestrator_assignments.png';
import authProvider from '../assets/lyndrix_screenshots/dark_settings_auth_provider.png';
import systemSettings from '../assets/lyndrix_screenshots/dark_settings_system.png';
import userProfile from '../assets/lyndrix_screenshots/dark_settings_user_profile.png';
import systemInfo from '../assets/lyndrix_screenshots/dark_system_info.png';
import userRights from '../assets/lyndrix_screenshots/dark_user_rights.png';

const screenshots = [
	{ src: dashboard.src, label: 'Dashboard' },
	{ src: login.src, label: 'Login' },
	{ src: pluginManager.src, label: 'Plugin Manager' },
	{ src: iacOrchestrator.src, label: 'IaC Orchestrator Plugin' },
	{ src: authProvider.src, label: 'Auth Providers' },
	{ src: systemSettings.src, label: 'System Settings' },
	{ src: userProfile.src, label: 'User Profile' },
	{ src: systemInfo.src, label: 'System Info' },
	{ src: userRights.src, label: 'User Rights' },
];
---

<section class="screenshots" id="screenshots">
	<div class="screenshots-container">
		<div class="section-header">
			<span class="section-tag">Screenshots</span>
			<h2 class="section-title">See it in action</h2>
			<p class="section-subtitle">
				A fully managed platform with a polished dark-mode UI — ready out of the box.
			</p>
		</div>

		<div class="tabs-row" id="tab-row" role="tablist">
			{screenshots.map((shot, i) => (
				<button
					class={`tab-btn${i === 0 ? ' active' : ''}`}
					data-index={i}
					role="tab"
					aria-selected={i === 0 ? 'true' : 'false'}
					aria-controls={`panel-${i}`}
					id={`tab-${i}`}
				>
					{shot.label}
				</button>
			))}
		</div>

		<div class="preview-frame" id="preview-frame" role="tabpanel">
			<div class="browser-bar">
				<div class="browser-dots">
					<span class="dot dot-red"></span>
					<span class="dot dot-yellow"></span>
					<span class="dot dot-green"></span>
				</div>
				<div class="browser-url" id="preview-url">lyndrix.local/dashboard</div>
			</div>
			<div class="preview-img-wrap">
				<img id="preview-img" src={screenshots[0].src} alt={screenshots[0].label} loading="lazy" />
			</div>
		</div>

		<div class="thumb-grid">
			{screenshots.map((shot, i) => (
				<button
					class={`thumb-btn${i === 0 ? ' active' : ''}`}
					data-index={i}
					aria-label={`View ${shot.label} screenshot`}
				>
					<img src={shot.src} alt={shot.label} loading="lazy" />
					<span class="thumb-label">{shot.label}</span>
				</button>
			))}
		</div>
	</div>
</section>

<script>
	const srcs: string[] = [];
	const labels: string[] = [];

	document.querySelectorAll<HTMLButtonElement>('.tab-btn').forEach((btn) => {
		const idx = Number(btn.dataset.index);
		const img = document.querySelector<HTMLImageElement>('.thumb-btn[data-index="' + idx + '"] img');
		if (img) {
			srcs[idx] = img.src;
			labels[idx] = btn.textContent?.trim() ?? '';
		}
	});

	// Also collect from thumbs directly
	document.querySelectorAll<HTMLButtonElement>('.thumb-btn').forEach((btn) => {
		const idx = Number(btn.dataset.index);
		const img = btn.querySelector<HTMLImageElement>('img');
		if (img) srcs[idx] = img.src;
	});

	// Collect preview src from server-rendered
	const previewImg = document.getElementById('preview-img') as HTMLImageElement | null;
	if (previewImg && !srcs[0]) srcs[0] = previewImg.src;

	function activate(index: number) {
		// Update tab buttons
		document.querySelectorAll<HTMLButtonElement>('.tab-btn').forEach((btn) => {
			const active = Number(btn.dataset.index) === index;
			btn.classList.toggle('active', active);
			btn.setAttribute('aria-selected', String(active));
		});

		// Update thumb buttons
		document.querySelectorAll<HTMLButtonElement>('.thumb-btn').forEach((btn) => {
			btn.classList.toggle('active', Number(btn.dataset.index) === index);
		});

		// Update preview
		if (previewImg) {
			previewImg.src = srcs[index] ?? '';
			previewImg.alt = labels[index] ?? '';
		}

		const urlEl = document.getElementById('preview-url');
		if (urlEl) {
			urlEl.textContent = 'lyndrix.local/' + (labels[index] ?? '').toLowerCase().replace(/\s+/g, '-');
		}
	}

	document.querySelectorAll<HTMLButtonElement>('.tab-btn').forEach((btn) => {
		btn.addEventListener('click', () => activate(Number(btn.dataset.index)));
	});

	document.querySelectorAll<HTMLButtonElement>('.thumb-btn').forEach((btn) => {
		btn.addEventListener('click', () => activate(Number(btn.dataset.index)));
	});
</script>

<style>
	.screenshots {
		padding: var(--section-padding);
		background: linear-gradient(180deg, var(--bg-primary) 0%, var(--bg-secondary) 100%);
	}

	.screenshots-container {
		max-width: var(--container-max);
		margin: 0 auto;
		display: flex;
		flex-direction: column;
		gap: 2.5rem;
	}

	.section-header {
		text-align: center;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1rem;
	}

	.section-tag {
		display: inline-block;
		padding: 0.3rem 0.875rem;
		background: rgba(0, 212, 255, 0.1);
		border: 1px solid rgba(0, 212, 255, 0.2);
		border-radius: 999px;
		font-size: 0.8rem;
		font-weight: 600;
		color: var(--accent-cyan);
		text-transform: uppercase;
		letter-spacing: 0.08em;
	}

	.section-title {
		font-size: clamp(2rem, 4vw, 3rem);
		font-weight: 800;
		line-height: 1.15;
		letter-spacing: -0.025em;
		color: var(--text-primary);
	}

	.section-subtitle {
		font-size: 1.1rem;
		color: var(--text-secondary);
		max-width: 560px;
		line-height: 1.7;
	}

	.tabs-row {
		display: flex;
		gap: 0.5rem;
		flex-wrap: wrap;
		justify-content: center;
	}

	.tab-btn {
		padding: 0.5rem 1rem;
		background: rgba(255, 255, 255, 0.04);
		border: 1px solid var(--border-card);
		border-radius: var(--radius-sm);
		font-size: 0.85rem;
		font-weight: 500;
		color: var(--text-secondary);
		cursor: pointer;
		transition: all var(--transition);
		font-family: var(--font-sans);
	}

	.tab-btn:hover {
		background: rgba(0, 212, 255, 0.08);
		border-color: rgba(0, 212, 255, 0.2);
		color: var(--text-primary);
	}

	.tab-btn.active {
		background: rgba(0, 212, 255, 0.12);
		border-color: rgba(0, 212, 255, 0.4);
		color: var(--accent-cyan);
		font-weight: 600;
	}

	.preview-frame {
		background: #0d1117;
		border: 1px solid var(--border-card);
		border-radius: var(--radius-lg);
		overflow: hidden;
		box-shadow: 0 32px 80px rgba(0, 0, 0, 0.6), 0 0 0 1px rgba(0, 212, 255, 0.08);
	}

	.browser-bar {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		padding: 0.75rem 1.25rem;
		background: #161b22;
		border-bottom: 1px solid rgba(255, 255, 255, 0.06);
	}

	.browser-dots {
		display: flex;
		gap: 5px;
	}

	.dot {
		width: 10px;
		height: 10px;
		border-radius: 50%;
	}
	.dot-red { background: #ff5f57; }
	.dot-yellow { background: #ffbd2e; }
	.dot-green { background: #28c840; }

	.browser-url {
		flex: 1;
		background: rgba(255, 255, 255, 0.06);
		border-radius: 4px;
		padding: 0.25rem 0.75rem;
		font-size: 0.75rem;
		font-family: var(--font-mono);
		color: var(--text-muted);
	}

	.preview-img-wrap {
		width: 100%;
		aspect-ratio: 16 / 9;
		overflow: hidden;
	}

	.preview-img-wrap img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: top;
		display: block;
		transition: opacity 0.2s ease;
	}

	.thumb-grid {
		display: grid;
		grid-template-columns: repeat(5, 1fr);
		gap: 0.75rem;
	}

	.thumb-btn {
		background: transparent;
		border: 1px solid var(--border-card);
		border-radius: var(--radius-md);
		overflow: hidden;
		cursor: pointer;
		padding: 0;
		transition: border-color var(--transition), box-shadow var(--transition);
		display: flex;
		flex-direction: column;
	}

	.thumb-btn:hover {
		border-color: rgba(0, 212, 255, 0.3);
		box-shadow: 0 0 16px rgba(0, 212, 255, 0.15);
	}

	.thumb-btn.active {
		border-color: var(--accent-cyan);
		box-shadow: 0 0 20px rgba(0, 212, 255, 0.25);
	}

	.thumb-btn img {
		width: 100%;
		aspect-ratio: 16 / 9;
		object-fit: cover;
		object-position: top;
	}

	.thumb-label {
		display: block;
		padding: 0.4rem 0.5rem;
		font-size: 0.7rem;
		color: var(--text-muted);
		text-align: center;
		background: rgba(0, 0, 0, 0.4);
		font-family: var(--font-sans);
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	@media (max-width: 1024px) {
		.thumb-grid {
			grid-template-columns: repeat(4, 1fr);
		}
	}

	@media (max-width: 768px) {
		.thumb-grid {
			grid-template-columns: repeat(3, 1fr);
		}

		.tabs-row {
			gap: 0.375rem;
		}

		.tab-btn {
			font-size: 0.8rem;
			padding: 0.4rem 0.75rem;
		}
	}

	@media (max-width: 480px) {
		.thumb-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}
</style>
