---
// --- New React UI (primary) ---
import reactDashboard from '../assets/lyndrix_screenshots/react_dashboard.png';
import reactPlugins from '../assets/lyndrix_screenshots/react_plugins.png';
import reactUsers from '../assets/lyndrix_screenshots/react_users.png';
import reactAppearance from '../assets/lyndrix_screenshots/react_appearance.png';
import reactMonitoring from '../assets/lyndrix_screenshots/react_monitoring.png';
import reactIac from '../assets/lyndrix_screenshots/react_iac.png';
import reactDocker from '../assets/lyndrix_screenshots/react_docker.png';
import reactSettings from '../assets/lyndrix_screenshots/react_settings.png';

// --- Classic NiceGUI UI (secondary) ---
import dashboard from '../assets/lyndrix_screenshots/dark_dashboard.png';
import login from '../assets/lyndrix_screenshots/dark_login_screen.png';
import pluginManager from '../assets/lyndrix_screenshots/dark_plugin_manager.png';
import iacOrchestrator from '../assets/lyndrix_screenshots/dark_plugin_iac_orchestrator_assignments.png';
import authProvider from '../assets/lyndrix_screenshots/dark_settings_auth_provider.png';
import systemSettings from '../assets/lyndrix_screenshots/dark_settings_system.png';
import userProfile from '../assets/lyndrix_screenshots/dark_settings_user_profile.png';
import systemInfo from '../assets/lyndrix_screenshots/dark_settings_info.png';
import userRights from '../assets/lyndrix_screenshots/dark_settings_user_rights.png';

// Two UI sets. The React UI is the default/primary set; the Classic NiceGUI
// shots stay available behind the switcher.
const uiSets = [
	{
		id: 'react',
		label: 'React UI',
		badge: 'New',
		shots: [
			{ src: reactDashboard.src, label: 'Dashboard', path: 'dashboard' },
			{ src: reactPlugins.src, label: 'Plugins', path: 'plugins' },
			{ src: reactMonitoring.src, label: 'State Monitoring', path: 'apps/monitoring' },
			{ src: reactDocker.src, label: 'Docker Manager', path: 'apps/docker' },
			{ src: reactIac.src, label: 'IaC Orchestrator', path: 'apps/iac' },
			{ src: reactUsers.src, label: 'Users', path: 'users' },
			{ src: reactAppearance.src, label: 'Appearance', path: 'settings/appearance' },
			{ src: reactSettings.src, label: 'Settings', path: 'settings' },
		],
	},
	{
		id: 'classic',
		label: 'Classic UI',
		badge: null,
		shots: [
			{ src: dashboard.src, label: 'Dashboard', path: 'dashboard' },
			{ src: login.src, label: 'Login', path: 'login' },
			{ src: pluginManager.src, label: 'Plugin Manager', path: 'plugins' },
			{ src: iacOrchestrator.src, label: 'IaC Orchestrator', path: 'apps/iac' },
			{ src: authProvider.src, label: 'Auth Providers', path: 'settings/auth' },
			{ src: systemSettings.src, label: 'System Settings', path: 'settings/system' },
			{ src: userProfile.src, label: 'User Profile', path: 'settings/profile' },
			{ src: systemInfo.src, label: 'System Info', path: 'settings/info' },
			{ src: userRights.src, label: 'User Rights', path: 'users/rights' },
		],
	},
];

const initial = uiSets[0];
---

<section class="screenshots" id="screenshots">
	<div class="screenshots-container">
		<div class="section-header">
			<span class="section-tag">Screenshots</span>
			<h2 class="section-title">See it in action</h2>
			<p class="section-subtitle">
				A polished, fully managed platform — now with a glassy React interface, and the
				classic NiceGUI dashboard still one click away.
			</p>
		</div>

		<div class="ui-switch" role="tablist" aria-label="Interface">
			{uiSets.map((set, i) => (
				<button
					class={`ui-switch-btn${i === 0 ? ' active' : ''}`}
					data-set={set.id}
					role="tab"
					aria-selected={i === 0 ? 'true' : 'false'}
				>
					{set.label}
					{set.badge && <span class="ui-switch-badge">{set.badge}</span>}
				</button>
			))}
		</div>

		<div class="tabs-row" id="tab-row" role="tablist"></div>

		<div class="preview-frame" id="preview-frame" role="tabpanel">
			<div class="browser-bar">
				<div class="browser-dots">
					<span class="dot dot-red"></span>
					<span class="dot dot-yellow"></span>
					<span class="dot dot-green"></span>
				</div>
				<div class="browser-url" id="preview-url">lyndrix.local/{initial.shots[0].path}</div>
			</div>
			<div class="preview-img-wrap">
				<img id="preview-img" src={initial.shots[0].src} alt={initial.shots[0].label} loading="lazy" />
			</div>
		</div>

		<div class="thumb-grid" id="thumb-grid"></div>
	</div>

	<script type="application/json" id="ui-sets-data" set:html={JSON.stringify(uiSets)}></script>
</section>

<script>
	type Shot = { src: string; label: string; path: string };
	type UiSet = { id: string; label: string; badge: string | null; shots: Shot[] };

	const dataEl = document.getElementById('ui-sets-data');
	const uiSets: UiSet[] = dataEl ? JSON.parse(dataEl.textContent ?? '[]') : [];

	const tabRow = document.getElementById('tab-row');
	const thumbGrid = document.getElementById('thumb-grid');
	const previewImg = document.getElementById('preview-img') as HTMLImageElement | null;
	const previewUrl = document.getElementById('preview-url');

	let activeSet = uiSets[0];
	let activeIndex = 0;

	function selectShot(index: number) {
		if (!activeSet) return;
		activeIndex = index;
		const shot = activeSet.shots[index];
		if (!shot) return;

		if (previewImg) {
			previewImg.src = shot.src;
			previewImg.alt = shot.label;
		}
		if (previewUrl) previewUrl.textContent = 'lyndrix.local/' + shot.path;

		tabRow?.querySelectorAll<HTMLButtonElement>('.tab-btn').forEach((btn) => {
			const active = Number(btn.dataset.index) === index;
			btn.classList.toggle('active', active);
			btn.setAttribute('aria-selected', String(active));
		});
		thumbGrid?.querySelectorAll<HTMLButtonElement>('.thumb-btn').forEach((btn) => {
			btn.classList.toggle('active', Number(btn.dataset.index) === index);
		});
	}

	function renderSet(set: UiSet) {
		activeSet = set;
		if (tabRow) tabRow.innerHTML = '';
		if (thumbGrid) thumbGrid.innerHTML = '';

		set.shots.forEach((shot, i) => {
			const tab = document.createElement('button');
			tab.className = 'tab-btn' + (i === 0 ? ' active' : '');
			tab.dataset.index = String(i);
			tab.setAttribute('role', 'tab');
			tab.setAttribute('aria-selected', i === 0 ? 'true' : 'false');
			tab.textContent = shot.label;
			tab.addEventListener('click', () => selectShot(i));
			tabRow?.appendChild(tab);

			const thumb = document.createElement('button');
			thumb.className = 'thumb-btn' + (i === 0 ? ' active' : '');
			thumb.dataset.index = String(i);
			thumb.setAttribute('aria-label', 'View ' + shot.label + ' screenshot');
			const img = document.createElement('img');
			img.src = shot.src;
			img.alt = shot.label;
			img.loading = 'lazy';
			const cap = document.createElement('span');
			cap.className = 'thumb-label';
			cap.textContent = shot.label;
			thumb.appendChild(img);
			thumb.appendChild(cap);
			thumb.addEventListener('click', () => selectShot(i));
			thumbGrid?.appendChild(thumb);
		});

		selectShot(0);
	}

	document.querySelectorAll<HTMLButtonElement>('.ui-switch-btn').forEach((btn) => {
		btn.addEventListener('click', () => {
			const set = uiSets.find((s) => s.id === btn.dataset.set);
			if (!set) return;
			document.querySelectorAll<HTMLButtonElement>('.ui-switch-btn').forEach((b) => {
				const active = b === btn;
				b.classList.toggle('active', active);
				b.setAttribute('aria-selected', String(active));
			});
			renderSet(set);
		});
	});

	if (activeSet) renderSet(activeSet);
</script>

<style>
	.screenshots {
		padding: var(--section-padding);
		background: linear-gradient(180deg, var(--bg-primary) 0%, var(--bg-secondary) 100%);
	}

	.screenshots-container {
		max-width: var(--container-max);
		margin: 0 auto;
		display: flex;
		flex-direction: column;
		gap: 2.5rem;
	}

	.section-header {
		text-align: center;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1rem;
	}

	.section-tag {
		display: inline-block;
		padding: 0.3rem 0.875rem;
		background: rgba(0, 212, 255, 0.1);
		border: 1px solid rgba(0, 212, 255, 0.2);
		border-radius: 999px;
		font-size: 0.8rem;
		font-weight: 600;
		color: var(--accent-cyan);
		text-transform: uppercase;
		letter-spacing: 0.08em;
	}

	.section-title {
		font-size: clamp(2rem, 4vw, 3rem);
		font-weight: 800;
		line-height: 1.15;
		letter-spacing: -0.025em;
		color: var(--text-primary);
	}

	.section-subtitle {
		font-size: 1.1rem;
		color: var(--text-secondary);
		max-width: 600px;
		line-height: 1.7;
	}

	/* UI set switcher — segmented control */
	.ui-switch {
		display: inline-flex;
		align-self: center;
		gap: 0.25rem;
		padding: 0.3rem;
		background: rgba(255, 255, 255, 0.04);
		border: 1px solid var(--border-card);
		border-radius: 999px;
	}

	.ui-switch-btn {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.5rem 1.25rem;
		background: transparent;
		border: none;
		border-radius: 999px;
		font-size: 0.9rem;
		font-weight: 600;
		color: var(--text-secondary);
		cursor: pointer;
		transition: all var(--transition);
		font-family: var(--font-sans);
	}

	.ui-switch-btn:hover {
		color: var(--text-primary);
	}

	.ui-switch-btn.active {
		background: linear-gradient(135deg, rgba(0, 212, 255, 0.18), rgba(0, 212, 255, 0.08));
		color: var(--accent-cyan);
		box-shadow: 0 0 16px rgba(0, 212, 255, 0.18);
	}

	.ui-switch-badge {
		font-size: 0.62rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		padding: 0.1rem 0.4rem;
		border-radius: 999px;
		background: var(--accent-cyan);
		color: #03121a;
	}

	.tabs-row {
		display: flex;
		gap: 0.5rem;
		flex-wrap: wrap;
		justify-content: center;
	}

	.tab-btn {
		padding: 0.5rem 1rem;
		background: rgba(255, 255, 255, 0.04);
		border: 1px solid var(--border-card);
		border-radius: var(--radius-sm);
		font-size: 0.85rem;
		font-weight: 500;
		color: var(--text-secondary);
		cursor: pointer;
		transition: all var(--transition);
		font-family: var(--font-sans);
	}

	.tab-btn:hover {
		background: rgba(0, 212, 255, 0.08);
		border-color: rgba(0, 212, 255, 0.2);
		color: var(--text-primary);
	}

	.tab-btn.active {
		background: rgba(0, 212, 255, 0.12);
		border-color: rgba(0, 212, 255, 0.4);
		color: var(--accent-cyan);
		font-weight: 600;
	}

	.preview-frame {
		background: #0d1117;
		border: 1px solid var(--border-card);
		border-radius: var(--radius-lg);
		overflow: hidden;
		box-shadow: 0 32px 80px rgba(0, 0, 0, 0.6), 0 0 0 1px rgba(0, 212, 255, 0.08);
	}

	.browser-bar {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		padding: 0.75rem 1.25rem;
		background: #161b22;
		border-bottom: 1px solid rgba(255, 255, 255, 0.06);
	}

	.browser-dots {
		display: flex;
		gap: 5px;
	}

	.dot {
		width: 10px;
		height: 10px;
		border-radius: 50%;
	}
	.dot-red { background: #ff5f57; }
	.dot-yellow { background: #ffbd2e; }
	.dot-green { background: #28c840; }

	.browser-url {
		flex: 1;
		background: rgba(255, 255, 255, 0.06);
		border-radius: 4px;
		padding: 0.25rem 0.75rem;
		font-size: 0.75rem;
		font-family: var(--font-mono);
		color: var(--text-muted);
	}

	.preview-img-wrap {
		width: 100%;
		overflow: hidden;
		background: #0d1117;
	}

	/* Show the full screenshot at its natural ratio — no cropping, so the
	   sidebar/edges of each UI stay intact regardless of capture aspect. */
	.preview-img-wrap img {
		width: 100%;
		height: auto;
		display: block;
		transition: opacity 0.2s ease;
	}

	.thumb-grid {
		display: grid;
		grid-template-columns: repeat(5, 1fr);
		gap: 0.75rem;
	}

	.thumb-btn {
		background: transparent;
		border: 1px solid var(--border-card);
		border-radius: var(--radius-md);
		overflow: hidden;
		cursor: pointer;
		padding: 0;
		transition: border-color var(--transition), box-shadow var(--transition);
		display: flex;
		flex-direction: column;
	}

	.thumb-btn:hover {
		border-color: rgba(0, 212, 255, 0.3);
		box-shadow: 0 0 16px rgba(0, 212, 255, 0.15);
	}

	.thumb-btn.active {
		border-color: var(--accent-cyan);
		box-shadow: 0 0 20px rgba(0, 212, 255, 0.25);
	}

	.thumb-btn img {
		width: 100%;
		aspect-ratio: 16 / 9;
		object-fit: cover;
		object-position: top;
	}

	.thumb-label {
		display: block;
		padding: 0.4rem 0.5rem;
		font-size: 0.7rem;
		color: var(--text-muted);
		text-align: center;
		background: rgba(0, 0, 0, 0.4);
		font-family: var(--font-sans);
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	@media (max-width: 1024px) {
		.thumb-grid {
			grid-template-columns: repeat(4, 1fr);
		}
	}

	@media (max-width: 768px) {
		.thumb-grid {
			grid-template-columns: repeat(3, 1fr);
		}

		.tabs-row {
			gap: 0.375rem;
		}

		.tab-btn {
			font-size: 0.8rem;
			padding: 0.4rem 0.75rem;
		}
	}

	@media (max-width: 480px) {
		.thumb-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}
</style>
