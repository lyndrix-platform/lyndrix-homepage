---
const docs = [
	{
		icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>`,
		title: 'Getting Started / Installation',
		description: 'Deploy Lyndrix Core with Docker in minutes. Everything from prerequisites to your first running instance.',
		url: 'https://docs.lyndrix.eu/deployment/',
		linkText: 'deployment.md',
	},
	{
		icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 00-1-1.73l-7-4a2 2 0 00-2 0l-7 4A2 2 0 003 8v8a2 2 0 001 1.73l7 4a2 2 0 002 0l7-4A2 2 0 0021 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></svg>`,
		title: 'Plugin Development Guide',
		description: 'Everything you need to build and publish a plugin — manifest, setup, permissions, UI, and more.',
		url: 'https://docs.lyndrix.eu/plugins/',
		linkText: 'plugins.md',
	},
	{
		icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0110 0v4"/></svg>`,
		title: 'Security & Vault',
		description: 'How Lyndrix handles secrets, Vault bootstrap and unseal, per-plugin isolation, and zero-trust design.',
		url: 'https://docs.lyndrix.eu/security/',
		linkText: 'security.md',
	},
	{
		icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.07 4.93l-1.41 1.41M5.34 18.66l-1.41 1.41M2 12h2M20 12h2M19.07 19.07l-1.41-1.41M5.34 5.34L3.93 3.93M12 2v2M12 20v2"/></svg>`,
		title: 'Architecture',
		description: 'The event-driven runtime design, boot sequence, subsystem map, and how all components fit together.',
		url: 'https://docs.lyndrix.eu/architecture/',
		linkText: 'architecture.md',
	},
	{
		icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>`,
		title: 'Core Components',
		description: 'Reference for all built-in components: auth, database, vault, event bus, UI framework, and more.',
		url: 'https://docs.lyndrix.eu/core-components/',
		linkText: 'core-components/',
	},
	{
		icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 01-.9 3.8 8.5 8.5 0 01-7.6 4.7 8.38 8.38 0 01-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 01-.9-3.8 8.5 8.5 0 014.7-7.6 8.38 8.38 0 013.8-.9h.5a8.48 8.48 0 018 8v.5z"/></svg>`,
		title: 'Messaging & Notifications',
		description: 'The messaging gateway, provider adapters, and the notification router that decides where each notification goes.',
		url: 'https://docs.lyndrix.eu/core-components/messaging/',
		linkText: 'core-components/messaging/',
	},
	{
		icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="13.5" cy="6.5" r="2.5"/><circle cx="17.5" cy="10.5" r="2.5"/><circle cx="8.5" cy="7.5" r="2.5"/><circle cx="6.5" cy="12.5" r="2.5"/><path d="M12 2a10 10 0 100 20 2.5 2.5 0 002-4 2.5 2.5 0 012-4h2a4 4 0 004-4 10 10 0 00-10-8z"/></svg>`,
		title: 'Theming',
		description: 'The two-layer theme engine — token and component themes, CSS variables, custom themes, and plugin-scoped overrides.',
		url: 'https://docs.lyndrix.eu/core-components/settings/#theming',
		linkText: 'settings/#theming',
	},
	{
		icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg>`,
		title: 'Plugin Ecosystem',
		description: 'The shipped first-party plugins, each linking to its own documentation site, plus how to install from the registry.',
		url: 'https://docs.lyndrix.eu/ecosystem/',
		linkText: 'ecosystem/',
	},
];
---

<section class="docs-section" id="docs">
	<div class="docs-container">
		<div class="section-header">
			<span class="section-tag">Documentation</span>
			<h2 class="section-title">Documentation</h2>
			<p class="section-subtitle">
				Lyndrix Core is fully documented. Start here:
			</p>
		</div>

		<div class="docs-grid">
			{docs.map((doc) => (
				<a href={doc.url} class="doc-card" target="_blank" rel="noopener noreferrer">
					<div class="doc-icon" set:html={doc.icon}></div>
					<div class="doc-body">
						<h3 class="doc-title">{doc.title}</h3>
						<p class="doc-description">{doc.description}</p>
						<span class="doc-link">
							<code>{doc.linkText}</code>
							<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
								<path d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6"/>
								<polyline points="15 3 21 3 21 9"/>
								<line x1="10" y1="14" x2="21" y2="3"/>
							</svg>
						</span>
					</div>
				</a>
			))}
		</div>
	</div>
</section>

<style>
	.docs-section {
		padding: var(--section-padding);
		background: var(--bg-primary);
	}

	.docs-container {
		max-width: var(--container-max);
		margin: 0 auto;
		display: flex;
		flex-direction: column;
		gap: 3rem;
	}

	.section-header {
		text-align: center;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1rem;
	}

	.section-tag {
		display: inline-block;
		padding: 0.3rem 0.875rem;
		background: rgba(0, 212, 255, 0.1);
		border: 1px solid rgba(0, 212, 255, 0.2);
		border-radius: 999px;
		font-size: 0.8rem;
		font-weight: 600;
		color: var(--accent-cyan);
		text-transform: uppercase;
		letter-spacing: 0.08em;
	}

	.section-title {
		font-size: clamp(2rem, 4vw, 3rem);
		font-weight: 800;
		line-height: 1.15;
		letter-spacing: -0.025em;
		color: var(--text-primary);
	}

	.section-subtitle {
		font-size: 1.1rem;
		color: var(--text-secondary);
		max-width: 560px;
		line-height: 1.7;
	}

	.docs-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1.25rem;
	}

	.doc-card {
		background: var(--bg-card);
		border: 1px solid var(--border-card);
		border-radius: var(--radius-lg);
		padding: 1.75rem;
		display: flex;
		gap: 1rem;
		text-decoration: none;
		transition: border-color var(--transition), box-shadow var(--transition), transform var(--transition);
		backdrop-filter: blur(8px);
	}

	.doc-card:hover {
		border-color: rgba(0, 212, 255, 0.35);
		box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3), 0 0 0 1px rgba(0, 212, 255, 0.1);
		transform: translateY(-3px);
	}

	.doc-icon {
		width: 44px;
		height: 44px;
		display: flex;
		align-items: center;
		justify-content: center;
		background: rgba(0, 212, 255, 0.1);
		border-radius: var(--radius-md);
		color: var(--accent-cyan);
		flex-shrink: 0;
	}

	.doc-body {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		flex: 1;
	}

	.doc-title {
		font-size: 1rem;
		font-weight: 700;
		color: var(--text-primary);
		letter-spacing: -0.01em;
	}

	.doc-description {
		font-size: 0.86rem;
		color: var(--text-secondary);
		line-height: 1.65;
		flex: 1;
	}

	.doc-link {
		display: inline-flex;
		align-items: center;
		gap: 0.375rem;
		color: var(--accent-cyan);
		font-size: 0.8rem;
		font-weight: 600;
		margin-top: 0.5rem;
	}

	.doc-link code {
		font-family: var(--font-mono);
		font-size: 0.8em;
	}

	@media (max-width: 1024px) {
		.docs-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (max-width: 640px) {
		.docs-grid {
			grid-template-columns: 1fr;
		}

		.doc-card {
			flex-direction: column;
		}
	}
</style>
